PORT=4000
# MongoDB Atlas free M0 cluster connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jaathiya
# Long random strings (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Free Cloudinary account -> Dashboard -> API environment variable
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
# Public URL of this server (used in share links)
PUBLIC_BASE_URL=https://jaathiya-api.onrender.com
# Comma-separated web origins allowed to call the API (native mobile apps don't need this)
CORS_ORIGINS=http://localhost:8081
DAILY_NEWS_LIMIT=50
# IST = +330 minutes; used to decide when a reporter's "day" resets
TZ_OFFSET_MINUTES=330
# First admin (npm run create-admin)
ADMIN_NAME=Mamidi Rajesh
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-now
# Imported e-papers: PDF pages are rendered at this DPI (72-300), and the largest upload in MB
IMPORT_DPI=200
IMPORT_MAX_MB=60
