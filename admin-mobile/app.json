{
  "expo": {
    "name": "JV Desk",
    "slug": "jaathiya-vaarthalu-desk",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.jaathiyavaarthalu.desk",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jaathiyavaarthalu.desk",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos for news cards.",
          "cameraPermission": "Take photos for news cards."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
